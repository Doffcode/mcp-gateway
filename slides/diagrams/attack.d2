*.style.font-size: 30
**.style.font-size: 30
(** -> **)[*].style.font-size: 24
direction: right
p: "Poisoned\ndescription" {style.fill: "#fde2e1"; style.stroke: "#c0392b"}
a: "Agent\nobeys it"
r: "Reads a\nsecret file"
l: "Secret\nleaked" {style.fill: "#fde2e1"; style.stroke: "#c0392b"}
p -> a -> r -> l
